        imageStore(efOut,p,efFetch(efPosition,p));imageStore(efOutAux,p,efFetch(efNormal,p));
    } else {
        vec3 previousWorld,previousNormal;vec2 identity,previousUV;vec2 motion=vec2(0);
        bool valid=ef.flags.x!=0&&efPreviousSurface(p,previousWorld,previousNormal,identity)&&efProject(previousWorld,ef.previousVP,previousUV);
        if(valid)motion=(vec2(p)+.5)/vec2(ef.dimensions.xy)-previousUV;
        imageStore(efOut,p,ef.extensions.y!=0 ? efFetch(efMeta,p):vec4(0));
        imageStore(efOutAux,p,vec4(motion,0,valid ? 1:0));
    }
}
